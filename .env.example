# =============================================================
# AI Research Agent — environment variables
# Copy this file to .env and fill in at least ONE provider key.
# =============================================================

# ---- App ----
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5174,http://localhost:8000

# ---- Auth (CHANGE THIS in production — must be 32+ chars) ----
SECRET_KEY=please-change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/research_agent

# ---- LLM providers (any ONE is enough; first configured wins) ----

# Groq — FREE, very fast, OpenAI-compatible.
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — FREE models available.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Hugging Face Inference Router (OpenAI-compatible).
HF_API_KEY=YOUR_HF_API_KEY_HERE
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Ollama (fully offline, free, runs on your machine).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# OpenAI (optional, paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Default provider preference: groq | openrouter | hf | ollama | openai
DEFAULT_PROVIDER=groq

# ---- RAG ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_DIR=./data/vector_store
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=30
